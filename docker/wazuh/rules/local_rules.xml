<!--
  home-soc-lab custom rules.
  These sit on top of Wazuh's built-in ruleset and fire for the three
  documented detection scenarios. IDs use the 100000-119999 range that
  Wazuh reserves for user-defined rules.
-->

<group name="local,syslog,sshd,">

  <!-- 100100: Multiple SSH authentication failures from a single source.
       Layered on Wazuh's stock 5712 rule but with a tighter timeframe and
       a custom comment that maps to the SOC playbook. -->
  <rule id="100100" level="10" frequency="6" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>home-soc-lab: SSH brute-force - 6+ failures from same source in 60s</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- 100101: Successful login immediately after a brute-force burst.
       Indicates the attacker likely succeeded - escalate. -->
  <!-- frequency removed: if_matched_sid already requires a prior match,
       so this rule fires when 5715 (successful login) lands within
       timeframe seconds of any 100100 from the same source IP. -->
  <rule id="100101" level="12" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <if_sid>5715</if_sid>
    <same_source_ip />
    <description>home-soc-lab: SSH brute-force followed by successful login - probable compromise</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,brute_force,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,web,attack,">

  <!-- 100200: SQL injection signatures in DVWA / Apache access logs.
       Triggers on union-based, error-based, and time-based payloads. -->
  <rule id="100200" level="10">
    <if_sid>31100</if_sid>
    <url>UNION|union|SELECT|select|sleep\(|SLEEP\(|--|%27|%22</url>
    <description>home-soc-lab: SQL injection signature observed against DVWA</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sql_injection,pci_dss_6.5.1,</group>
  </rule>

  <!-- 100201: Repeated SQLi attempts from a single source - active probing -->
  <rule id="100201" level="12" frequency="10" timeframe="120">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>home-soc-lab: Active SQL injection probing - 10+ attempts in 120s</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sql_injection,</group>
  </rule>

</group>

<group name="local,syscheck,">

  <!-- 100300: Suspicious binary written to a world-writable temp path.
       FIM (syscheck) generates 554 / 550 / 553 events which we promote
       when the path or file extension is suspicious. -->
  <rule id="100300" level="11">
    <if_sid>550,553,554</if_sid>
    <!-- type="pcre2" is required for top-level alternation (the |).
         OSMatch (the default) does not support that grammar. -->
    <field name="file" type="pcre2">/tmp/.*\.(sh|elf|bin|py)$|/dev/shm/.*</field>
    <description>home-soc-lab: Suspicious executable dropped in temp path</description>
    <mitre>
      <id>T1059</id>
      <id>T1105</id>
    </mitre>
    <group>syscheck,malware_drop,</group>
  </rule>

</group>
