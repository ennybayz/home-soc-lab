# Copy to .env and fill in real values before bringing the stack up.
# .env is gitignored - never commit secrets.

# Wazuh stack version. Bump and re-pull to upgrade.
WAZUH_VERSION=4.7.5

# Wazuh indexer admin credentials
INDEXER_PASSWORD=ChangeMe_Indexer_2025!

# Wazuh API user (used by the dashboard)
API_PASSWORD=ChangeMe_Api_2025!

# Wazuh dashboard service user (kibanaserver)
DASHBOARD_PASSWORD=ChangeMe_Dashboard_2025!
